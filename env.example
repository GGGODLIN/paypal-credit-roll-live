# PayPal Sandbox credentials, can be obtained from developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# Optional: AG Studio licence key for /dashboard.
AG_STUDIO=

# Optional: the AG Studio AI assistant on /dashboard. If blank, an OPENAI_API_KEY already in
# your environment is used instead; with neither, the assistant is hidden.
AG_STUDIO_OPENAI_API_KEY=

# Also enables the explicit credit/contract review in Ghost Patchbay.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# First model is used for credit review; all entries are offered by Studio chat.
OPENAI_MODELS=gpt-4o-mini
# Public deployment origin used for PayPal approval/cancellation redirects.
APP_BASE_URL=https://paypal-credit-roll-live.onrender.com
